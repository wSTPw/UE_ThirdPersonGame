# ============================================================
# Unreal Engine 5 - .gitignore
# ============================================================

# --- 编译产物 ---
Binaries/
DerivedDataCache/
Intermediate/
# Saved/ 整目录排除（含 MHWIRestoration 批次输出与备份）。
# 注意：被忽略目录内的文件无法用 ! 反选，需要入库的证据 JSON 请归档到已跟踪的 Tools/MHW/ 下。
Saved/

# --- IDE ---
.vscode/
.vs/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# --- UE5 自动生成 ---
__ExternalActors__/
__ExternalObjects__/
*.Build.cs.xml

# --- 操作系统 ---
Thumbs.db
.DS_Store
Desktop.ini

# UE 5.8 generated solution files
*.slnx

# Local Node.js dependencies for the project MCP server
node_modules/

# UE-MCP machine-local configuration
ue-mcp.local.yml

# MHW local source assets and portable conversion dependencies
/ArtSource/ThirdParty/MHWLongSword/nativePC/
/ArtSource/ThirdParty/MHWLongSword/Converted/
/ArtSource/ThirdParty/MHWLongSword/archive-index.json
/ArtSource/ThirdParty/MHWLongSword/player-candidates.json
/Tools/MHW/Downloads/
/Tools/MHW/Source/
/Tools/MHW/BlenderAddons/
/Tools/MHW/Runtime/
/Tools/MHW/*.log

# Python 缓存：脚本每次运行都会重新生成，字节内容不稳定，不入库
__pycache__/
*.pyc
*.pyo

# MHW Rathalos datamine output (game binaries stay local; manifests/scripts are tracked)
/ArtSource/ThirdParty/MHWRathalos/nativePC/
/ArtSource/ThirdParty/MHWRathalos/archive-index.json
/ArtSource/ThirdParty/MHWRathalos-em002/nativePC/
/ArtSource/ThirdParty/MHWRathalos-em002/archive-index.json

# 全量动作库（848 个 / 1.6GB）是可重建的中间产物：源 LMT、导出脚本与证据 JSON 均已入库，
# 需要时用 Tools/MHW/convert_monster_animations.py 重新导出并按需导入。参考 Rathian 的按需导入模式。
# 例外：A_em001_02_001 被 MHWIRathianApproxData.cpp 硬编码引用，已 git add -f 入库；
# 今后新增源码引用必须同样 -f 补入，否则新克隆会静默缺动画。
/Content/MHWI/Rathalos/Animations/

# DevFlow 任务副本属私有基线，不随仓库分发（见 CHG-20261107-001）
/Tools/DevFlow/
