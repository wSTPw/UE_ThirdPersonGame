# ============================================================
# Unreal Engine 5 - .gitignore
# ============================================================

# --- 编译产物 ---
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# --- IDE ---
.vscode/
.vs/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# --- UE5 自动生成 ---
__ExternalActors__/
__ExternalObjects__/
*.Build.cs.xml

# --- 操作系统 ---
Thumbs.db
.DS_Store
Desktop.ini

# UE 5.8 generated solution files
*.slnx

# Local Node.js dependencies for the project MCP server
node_modules/

# UE-MCP machine-local configuration
ue-mcp.local.yml

# MHW local source assets and portable conversion dependencies
/ArtSource/ThirdParty/MHWLongSword/nativePC/
/ArtSource/ThirdParty/MHWLongSword/Converted/
/ArtSource/ThirdParty/MHWLongSword/archive-index.json
/ArtSource/ThirdParty/MHWLongSword/player-candidates.json
/Tools/MHW/Downloads/
/Tools/MHW/Source/
/Tools/MHW/BlenderAddons/
/Tools/MHW/Runtime/
/Tools/MHW/*.log

# Python 缓存：脚本每次运行都会重新生成，字节内容不稳定，不入库
__pycache__/
*.pyc
*.pyo
